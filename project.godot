; Engine configuration file.
config_version=5

[application]
config/name="Operation Value Chain"
config/description="A story-driven FPS that teaches Marketing: An Introduction, chapters 1-7."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
textures/canvas_textures/default_texture_filter=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[autoload]
Game="*res://src/game.gd"
Audio="*res://src/audio.gd"
Fx="*res://src/sys/fx.gd"

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[audio]
driver/mix_rate=48000

[gui]
theme/default_font_multichannel_signed_distance_field=false

[debug]
gdscript/warnings/inference_on_variant=1
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/return_value_discarded=0
